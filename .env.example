# --- Servidor ---
PORT=3000
NODE_ENV=development

# Firma la cookie de sesión. En producción la app NO ARRANCA si falta o si tiene
# menos de 32 caracteres: con este valor se puede falsificar la sesión de
# cualquiera, incluida la del administrador. Genera el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# --- PostgreSQL ---
# Usa DATABASE_URL (recomendado, funciona en Vercel Postgres/Neon/Supabase/Railway/etc.)
DATABASE_URL=postgres://usuario:password@host:5432/basededatos
# En producción la conexión va por TLS con el certificado verificado. Los
# proveedores habituales (Neon, Supabase, Railway, Vercel) funcionan sin tocar
# nada. Solo si el tuyo usa una autoridad propia, pega aquí su certificado.
DATABASE_CA_CERT=
# O bien variables sueltas (se usan si DATABASE_URL no está definida)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=tienda_web

# --- Cuenta admin inicial (se crea al correr db:init si no existe) ---
# ADMIN_PASSWORD no tiene valor por defecto y necesita al menos 12 caracteres:
# `db:init` se niega a crear la cuenta sin ella. Una contraseña de ejemplo
# escrita en el repositorio es una contraseña pública.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# Después puedes cambiarla desde el panel, en Ajustes.
ADMIN_EMAIL=admin@tutienda.com
ADMIN_PASSWORD=

# --- WhatsApp (Twilio) — opcional, déjalo vacío hasta que tengas cuenta ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Fotos de producto (Vercel Blob) ---
# Se agrega sola al conectar un Blob store al proyecto desde Vercel → Storage.
# Sin esto, en local las fotos se guardan en src/public/uploads/ (solo para probar).
BLOB_READ_WRITE_TOKEN=

# ============================================================
#  Anuncios: Google Ads y TikTok Ads
# ============================================================
# Nada de esto es opcional para anunciarse, pero todo es opcional para que la
# tienda funcione: si un valor queda vacío, ese script no se carga y su dominio
# ni siquiera se abre en la política de seguridad del sitio.

# --- Dominio público ---
# De aquí salen las URLs canónicas, el sitemap, la vista previa al compartir y
# el enlace de cada producto en los feeds de catálogo. Sin barra final.
# En Vercel se deduce solo, pero conviene fijarlo al dominio propio.
SITE_URL=https://arborea.com

# --- Datos del negocio (los revisa un humano antes de aprobar la cuenta) ---
BUSINESS_LEGAL_NAME=
BUSINESS_TAX_ID=
BUSINESS_EMAIL=
BUSINESS_PHONE=+57...
BUSINESS_WHATSAPP=+57...
BUSINESS_STREET=
BUSINESS_CITY=
BUSINESS_REGION=
BUSINESS_POSTAL_CODE=
BUSINESS_COUNTRY=CO
BUSINESS_HOURS=Lunes a viernes, 8:00 a 17:00

# --- Condiciones comerciales publicadas en /envios-y-devoluciones ---
STORE_CURRENCY=COP
SHIPPING_DAYS=2 a 5 días hábiles
SHIPPING_COST_TEXT=Se calcula al confirmar el pedido por WhatsApp
SHIPPING_AREA=Colombia
RETURN_DAYS=5

# --- Redes (TikTok verifica que la marca exista fuera del sitio) ---
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_FACEBOOK=

# --- Verificación de propiedad del dominio ---
# Google Search Console → Etiqueta HTML: copia solo el valor del content.
# Habilita también Merchant Center.
GOOGLE_SITE_VERIFICATION=
# TikTok Business Center → Assets → Website → verificar por meta tag.
TIKTOK_DOMAIN_VERIFICATION=

# --- Medición ---
# Google Analytics 4, formato G-XXXXXXXXXX
GA4_MEASUREMENT_ID=
# Google Ads, formato AW-XXXXXXXXX
GOOGLE_ADS_ID=
# Etiqueta de la acción de conversión "compra" en Google Ads. En la interfaz
# aparece como AW-XXXXXXXXX/AbC-D_efGh: aquí va solo la parte de después de "/".
GOOGLE_ADS_PURCHASE_LABEL=
TIKTOK_PIXEL_ID=
