<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: 'Panel' }) %></head>
<body>
<%- include('../partials/admin-nav', { active: 'dashboard' }) %>

  <h1 class="admin-title">Estado general</h1>

  <div class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-sm border border-line bg-line lg:grid-cols-4">
    <div class="bg-surface p-6">
      <p class="text-[10px] uppercase tracking-wander text-sandDim">Productos activos</p>
      <p class="admin-metric mt-3"><%= stats.total_products %></p>
    </div>
    <div class="bg-surface p-6">
      <p class="text-[10px] uppercase tracking-wander text-sandDim">Pedidos entrantes</p>
      <p class="admin-metric mt-3 <%= Number(stats.incoming) > 0 ? 'text-warn' : '' %>"><%= stats.incoming %></p>
      <% if (Number(stats.incoming) > 0) { %>
        <a href="/admin/pedidos?vista=entrantes" class="mt-3 inline-block text-[10px] uppercase tracking-wander text-gold hover:underline">
          Atender ahora
        </a>
      <% } %>
    </div>
    <div class="bg-surface p-6">
      <p class="text-[10px] uppercase tracking-wander text-sandDim">Pedidos salientes</p>
      <p class="admin-metric mt-3"><%= stats.outgoing %></p>
    </div>
    <div class="bg-surface p-6">
      <p class="text-[10px] uppercase tracking-wander text-sandDim">Ingresos acumulados</p>
      <p class="admin-metric mt-3 text-ok"><%= money(stats.revenue) %></p>
    </div>
  </div>

  <div class="mt-14">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-2xl text-ink">Pedidos recientes</h2>
      <a href="/admin/pedidos" class="text-[10px] uppercase tracking-wander text-gold hover:underline">Ver todos</a>
    </div>

    <div class="admin-panel mt-5 overflow-x-auto">
      <% if (recentOrders.length === 0) { %>
        <p class="px-5 py-12 text-center text-sm text-sandDim">Aún no hay pedidos.</p>
      <% } else { %>
        <table class="admin-table">
          <caption class="sr-only">Últimos pedidos recibidos</caption>
          <thead>
            <tr>
              <th scope="col">Pedido</th>
              <th scope="col">Cliente</th>
              <th scope="col">Fecha</th>
              <th scope="col" class="!text-right">Total</th>
              <th scope="col">Estado</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(function (o) { %>
              <tr>
                <td class="num !text-left">
                  <a href="/admin/pedidos/<%= o.id %>" class="text-ink hover:text-gold">n.º <%= o.id %></a>
                </td>
                <td class="whitespace-nowrap text-ink"><%= o.customer_name %></td>
                <td class="whitespace-nowrap"><%= new Date(o.created_at).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                <td class="num"><%= money(o.total) %></td>
                <td><%- include('../partials/order-status', { status: o.status }) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

<%- include('../partials/admin-close') %>
</body>
</html>
