<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: 'Panel' }) %></head>
<body>
<%- include('../partials/admin-nav', { active: 'dashboard' }) %>

  <span class="label-eyebrow">Resumen</span>
  <h1 class="mt-2 text-3xl font-bold">Estado general</h1>

  <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <div class="card p-6">
      <p class="label-eyebrow">Productos activos</p>
      <p class="mt-3 font-mono text-3xl font-semibold"><%= stats.total_products %></p>
    </div>
    <div class="card p-6">
      <p class="label-eyebrow">Pedidos entrantes</p>
      <p class="mt-3 font-mono text-3xl font-semibold text-warn"><%= stats.incoming %></p>
    </div>
    <div class="card p-6">
      <p class="label-eyebrow">Pedidos salientes</p>
      <p class="mt-3 font-mono text-3xl font-semibold text-clay"><%= stats.outgoing %></p>
    </div>
    <div class="card p-6">
      <p class="label-eyebrow">Ingresos acumulados</p>
      <p class="mt-3 font-mono text-3xl font-semibold text-ok">$<%= Number(stats.revenue).toFixed(2) %></p>
    </div>
  </div>

  <div class="mt-10">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold">Pedidos recientes</h2>
      <a href="/admin/pedidos" class="text-sm text-clay hover:underline">Ver todos</a>
    </div>
    <div class="mt-5 divide-y divide-line rounded-2xl border border-line bg-surface">
      <% recentOrders.forEach(o => { %>
        <a href="/admin/pedidos/<%= o.id %>" class="flex items-center justify-between p-5 hover:bg-surface2">
          <div>
            <p class="font-medium">#<%= o.id %> — <%= o.customer_name %></p>
            <p class="text-sm text-moss"><%= new Date(o.created_at).toLocaleString('es-CO') %></p>
          </div>
          <div class="flex items-center gap-4">
            <span class="font-mono text-clay">$<%= Number(o.total).toFixed(2) %></span>
            <span class="status-pill bg-surface2 text-moss"><%= o.status %></span>
          </div>
        </a>
      <% }) %>
      <% if (recentOrders.length === 0) { %>
        <p class="p-6 text-center text-moss">Aún no hay pedidos.</p>
      <% } %>
    </div>
  </div>

<%- include('../partials/admin-close') %>
</body>
</html>
