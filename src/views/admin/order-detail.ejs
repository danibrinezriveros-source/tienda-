<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: 'Pedido #' + order.id }) %></head>
<body>
<%- include('../partials/admin-nav', { active: 'pedidos' }) %>

  <a href="/admin/pedidos" class="text-[10px] uppercase tracking-wander text-sandDim transition-colors hover:text-ink">← Pedidos</a>

  <div class="mt-5 flex flex-wrap items-center gap-5">
    <h1 class="admin-title">Pedido n.º <%= order.id %></h1>
    <%- include('../partials/order-status', { status: order.status }) %>
  </div>
  <p class="mt-3 text-sm text-sandDim">
    Recibido el <%= new Date(order.created_at).toLocaleString('es-CO') %>
  </p>

  <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="admin-panel overflow-x-auto">
        <table class="admin-table">
          <caption class="sr-only">Artículos del pedido</caption>
          <thead>
            <tr>
              <th scope="col">Producto</th>
              <th scope="col" class="!text-right">Cantidad</th>
              <th scope="col" class="!text-right">Unitario</th>
              <th scope="col" class="!text-right">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function (i) { %>
              <tr>
                <td class="text-ink"><%= i.product_name %></td>
                <td class="num"><%= i.quantity %></td>
                <td class="num">$<%= Number(i.unit_price).toLocaleString('es-CO', { maximumFractionDigits: 0 }) %></td>
                <td class="num">$<%= (i.unit_price * i.quantity).toLocaleString('es-CO', { maximumFractionDigits: 0 }) %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr class="border-t border-line">
              <td colspan="3" class="text-[10px] uppercase tracking-wander text-sandDim">Total</td>
              <td class="num font-display text-xl text-gold">
                $<%= Number(order.total).toLocaleString('es-CO', { maximumFractionDigits: 0 }) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <div class="space-y-6">
      <div class="admin-panel p-5">
        <h2 class="text-[10px] uppercase tracking-wander text-sandDim">Cliente</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="sr-only">Nombre</dt>
            <dd class="text-ink"><%= order.customer_name %></dd>
          </div>
          <div>
            <dt class="sr-only">Teléfono</dt>
            <dd><a href="tel:<%= order.customer_phone %>" class="text-gold hover:underline"><%= order.customer_phone %></a></dd>
          </div>
          <div>
            <dt class="sr-only">Correo</dt>
            <dd class="break-all text-sandDim"><%= order.customer_email %></dd>
          </div>
          <div class="border-t border-line pt-3">
            <dt class="text-[10px] uppercase tracking-wander text-sandDim">Dirección</dt>
            <dd class="mt-1.5 leading-relaxed text-sand"><%= order.address %></dd>
          </div>
          <% if (order.notes) { %>
            <div class="border-t border-line pt-3">
              <dt class="text-[10px] uppercase tracking-wander text-sandDim">Notas</dt>
              <dd class="mt-1.5 leading-relaxed text-sand"><%= order.notes %></dd>
            </div>
          <% } %>
        </dl>
      </div>

      <div class="admin-panel p-5">
        <h2 class="text-[10px] uppercase tracking-wander text-sandDim">Cambiar estado</h2>
        <form action="/admin/pedidos/<%= order.id %>/estado" method="POST" class="mt-4 space-y-4">
          <label for="status" class="sr-only">Nuevo estado</label>
          <select id="status" name="status" class="admin-field">
            <% [
              ['pendiente', 'Pendiente'],
              ['confirmado', 'Confirmado'],
              ['en_preparacion', 'En preparación'],
              ['enviado', 'Enviado'],
              ['entregado', 'Entregado'],
              ['cancelado', 'Cancelado']
            ].forEach(function (s) { %>
              <option value="<%= s[0] %>" <%= order.status === s[0] ? 'selected' : '' %>><%= s[1] %></option>
            <% }) %>
          </select>
          <button type="submit" class="admin-btn w-full">Actualizar</button>
        </form>
      </div>
    </div>
  </div>

<%- include('../partials/admin-close') %>
</body>
</html>
