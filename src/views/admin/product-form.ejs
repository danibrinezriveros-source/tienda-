<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: product ? 'Editar producto' : 'Nuevo producto' }) %></head>
<body>
<%- include('../partials/admin-nav', { active: 'productos' }) %>

  <a href="/admin/productos" class="text-sm text-moss hover:text-ink">&larr; Catálogo</a>
  <h1 class="mt-3 text-3xl font-bold"><%= product ? 'Editar producto' : 'Nuevo producto' %></h1>

  <form action="<%= product ? `/admin/productos/${product.id}/editar` : '/admin/productos/nuevo' %>" method="POST" enctype="multipart/form-data" class="mt-8 max-w-xl space-y-5">
    <div>
      <label class="mb-1 block text-sm text-moss">Nombre</label>
      <input type="text" name="name" required value="<%= product ? product.name : '' %>" class="input-field" />
    </div>
    <div>
      <label class="mb-1 block text-sm text-moss">Descripción</label>
      <textarea name="description" rows="3" class="input-field"><%= product ? product.description : '' %></textarea>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="mb-1 block text-sm text-moss">Precio</label>
        <input type="number" step="0.01" name="price" required value="<%= product ? product.price : '' %>" class="input-field" />
      </div>
      <div>
        <label class="mb-1 block text-sm text-moss">Stock</label>
        <input type="number" name="stock" required value="<%= product ? product.stock : 0 %>" class="input-field" />
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="mb-1 block text-sm text-moss">Categoría</label>
        <input type="text" name="category" required value="<%= product ? product.category : '' %>" class="input-field" />
      </div>
      <div>
        <label class="mb-1 block text-sm text-moss">Etiquetas (separadas por coma)</label>
        <input type="text" name="tags" value="<%= product ? product.tags : '' %>" placeholder="rapido,economico,exterior" class="input-field" />
      </div>
    </div>
    <div>
      <label class="mb-1 block text-sm text-moss">Foto del producto</label>
      <% if (product && product.image_url) { %>
        <div class="mb-3 h-36 w-36 overflow-hidden rounded-xl border border-line bg-surface2">
          <img src="<%= product.image_url %>" alt="" class="h-full w-full object-cover" />
        </div>
      <% } %>
      <input type="file" name="image" accept="image/*" class="w-full text-sm text-moss file:mr-4 file:rounded-full file:border-0 file:bg-leaf file:px-4 file:py-2 file:text-sm file:font-semibold file:text-cream" />
      <p class="mt-1.5 text-xs text-moss">Sube una foto desde tu computador o celular (JPG o PNG, máx. 5&nbsp;MB). Si subes una, reemplaza la URL de abajo.</p>
    </div>
    <div>
      <label class="mb-1 block text-sm text-moss">O pega la URL de una imagen</label>
      <input type="url" name="image_url" value="<%= product ? (product.image_url || '') : '' %>" class="input-field" />
    </div>

    <% if (product) { %>
      <label class="flex items-center gap-2 text-sm text-moss">
        <input type="checkbox" name="active" <%= product.active ? 'checked' : '' %> class="rounded border-line bg-surface2" />
        Producto visible en la tienda
      </label>
    <% } %>

    <button type="submit" class="btn-primary">Guardar producto</button>
  </form>

<%- include('../partials/admin-close') %>
</body>
</html>
