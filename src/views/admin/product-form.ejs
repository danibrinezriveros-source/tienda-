<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: product ? 'Editar producto' : 'Nuevo producto' }) %></head>
<body>
<%- include('../partials/admin-nav', { active: 'productos' }) %>

  <a href="/admin/productos" class="text-[10px] uppercase tracking-wander text-sandDim transition-colors hover:text-ink">← Catálogo</a>
  <h1 class="admin-title mt-5"><%= product ? 'Editar producto' : 'Nuevo producto' %></h1>

  <% if (error) { %>
    <p class="admin-note admin-note-danger mt-6 max-w-2xl" role="alert"><%= error %></p>
  <% } %>

  <form action="<%= product ? `/admin/productos/${product.id}/editar` : '/admin/productos/nuevo' %>"
        method="POST" enctype="multipart/form-data" class="mt-10 max-w-2xl">

    <div class="admin-panel space-y-6 p-6">
      <div>
        <label for="name" class="admin-label">Nombre</label>
        <input id="name" type="text" name="name" required value="<%= product ? product.name : '' %>" class="admin-field" />
      </div>
      <div>
        <label for="description" class="admin-label">Descripción</label>
        <textarea id="description" name="description" rows="3" class="admin-field resize-y"><%= product ? product.description : '' %></textarea>
      </div>
      <div class="grid grid-cols-2 gap-5">
        <div>
          <label for="price" class="admin-label">Precio</label>
          <input id="price" type="number" step="0.01" min="0" name="price" required value="<%= product ? product.price : '' %>" class="admin-field" />
        </div>
        <div>
          <label for="stock" class="admin-label">Stock</label>
          <input id="stock" type="number" min="0" name="stock" required value="<%= product ? product.stock : 0 %>" class="admin-field" />
        </div>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="category" class="admin-label">Categoría</label>
          <input id="category" type="text" name="category" required value="<%= product ? product.category : '' %>" class="admin-field" />
          <p class="mt-2 text-xs leading-relaxed text-sandDim">
            La categoría decide en qué ecosistema aparece la planta en la tienda.
          </p>
        </div>
        <div>
          <label for="tags" class="admin-label">Etiquetas</label>
          <input id="tags" type="text" name="tags" value="<%= product ? product.tags : '' %>"
                 placeholder="principiante,poca-luz,pet-friendly" class="admin-field" />
          <p class="mt-2 text-xs leading-relaxed text-sandDim">
            Separadas por coma. Alimentan el asistente de compra y la ficha de cuidado.
          </p>
        </div>
      </div>
    </div>

    <div class="admin-panel mt-6 space-y-6 p-6">
      <h2 class="text-[10px] uppercase tracking-wander text-sandDim">Imagen</h2>

      <% if (product && product.image_url) { %>
        <div class="h-32 w-32 overflow-hidden rounded-sm border border-line bg-surface2">
          <img src="<%= product.image_url %>" alt="Foto actual de <%= product.name %>" class="h-full w-full object-cover" />
        </div>
      <% } %>

      <div>
        <label for="image" class="admin-label">Subir una foto</label>
        <input id="image" type="file" name="image" accept="image/*" class="admin-file" />
        <p class="mt-2 text-xs leading-relaxed text-sandDim">
          Desde el computador o el celular (JPG o PNG, máx. 5&nbsp;MB). Si subes una, reemplaza la URL de abajo.
        </p>
      </div>

      <div>
        <label for="image_url" class="admin-label">O pegar la URL de una imagen</label>
        <input id="image_url" type="url" name="image_url" value="<%= product ? (product.image_url || '') : '' %>" class="admin-field" />
        <p class="mt-2 text-xs leading-relaxed text-sandDim">
          Sin foto, la tienda dibuja una ilustración según la categoría de la planta.
        </p>
      </div>
    </div>

    <% if (product) { %>
      <label class="mt-6 flex items-center gap-3 text-sm text-sand">
        <input type="checkbox" name="active" <%= product.active ? 'checked' : '' %>
               class="h-4 w-4 rounded-sm border border-line bg-surface2 accent-gold" />
        Visible en la tienda
      </label>
    <% } %>

    <div class="mt-8 flex flex-wrap items-center gap-5">
      <button type="submit" class="admin-btn">Guardar producto</button>
      <a href="/admin/productos" class="text-[10px] uppercase tracking-wander text-sandDim transition-colors hover:text-ink">Cancelar</a>
    </div>
  </form>

<%- include('../partials/admin-close') %>
</body>
</html>
