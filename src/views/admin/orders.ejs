<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: 'Pedidos' }) %></head>
<body>
<%- include('../partials/admin-nav', { active: 'pedidos' }) %>

  <span class="label-eyebrow">Pedidos</span>
  <h1 class="mt-2 text-3xl font-bold">Gestión de pedidos</h1>

  <div class="mt-6 inline-flex rounded-full border border-line bg-surface p-1">
    <a href="/admin/pedidos?vista=entrantes" class="rounded-full px-5 py-2 text-sm <%= view === 'entrantes' ? 'bg-leaf text-cream' : 'text-moss hover:text-ink' %>">
      Entrantes
    </a>
    <a href="/admin/pedidos?vista=salientes" class="rounded-full px-5 py-2 text-sm <%= view === 'salientes' ? 'bg-leaf text-cream' : 'text-moss hover:text-ink' %>">
      Salientes
    </a>
  </div>

  <p class="mt-4 text-sm text-moss">
    <% if (view === 'entrantes') { %>
      Pedidos nuevos esperando confirmación.
    <% } else { %>
      Pedidos ya confirmados, en preparación, enviados, entregados o cancelados.
    <% } %>
  </p>

  <div class="mt-6 divide-y divide-line rounded-2xl border border-line bg-surface">
    <% orders.forEach(o => { %>
      <a href="/admin/pedidos/<%= o.id %>" class="flex flex-wrap items-center justify-between gap-3 p-5 hover:bg-surface2">
        <div>
          <p class="font-medium">#<%= o.id %> — <%= o.customer_name %></p>
          <p class="text-sm text-moss"><%= o.customer_phone %> · <%= new Date(o.created_at).toLocaleString('es-CO') %></p>
        </div>
        <div class="flex items-center gap-4">
          <span class="font-mono text-clay">$<%= Number(o.total).toFixed(2) %></span>
          <span class="status-pill bg-surface2 text-moss"><%= o.status %></span>
        </div>
      </a>
    <% }) %>
    <% if (orders.length === 0) { %>
      <p class="p-8 text-center text-moss">No hay pedidos en esta vista.</p>
    <% } %>
  </div>

<%- include('../partials/admin-close') %>
</body>
</html>
