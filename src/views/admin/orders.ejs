<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: 'Pedidos' }) %></head>
<body>
<%- include('../partials/admin-nav', { active: 'pedidos' }) %>

  <h1 class="admin-title">Pedidos</h1>

  <div class="mt-8 flex gap-8 border-b border-line">
    <a href="/admin/pedidos?vista=entrantes" class="admin-tab"
       <%= view === 'entrantes' ? 'aria-current="page"' : '' %>>Entrantes</a>
    <a href="/admin/pedidos?vista=salientes" class="admin-tab"
       <%= view === 'salientes' ? 'aria-current="page"' : '' %>>Salientes</a>
  </div>

  <p class="mt-5 text-sm text-sandDim">
    <% if (view === 'entrantes') { %>
      Pedidos nuevos esperando confirmación.
    <% } else { %>
      Pedidos ya confirmados, en preparación, enviados, entregados o cancelados.
    <% } %>
  </p>

  <div class="admin-panel mt-6 overflow-x-auto">
    <% if (orders.length === 0) { %>
      <p class="px-5 py-16 text-center text-sm text-sandDim">No hay pedidos en esta vista.</p>
    <% } else { %>
      <table class="admin-table">
        <caption class="sr-only">Pedidos <%= view %></caption>
        <thead>
          <tr>
            <th scope="col">Pedido</th>
            <th scope="col">Cliente</th>
            <th scope="col" class="hidden lg:table-cell">Contacto</th>
            <th scope="col">Fecha</th>
            <th scope="col" class="!text-right">Total</th>
            <th scope="col">Estado</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function (o) { %>
            <tr>
              <td class="num !text-left">
                <a href="/admin/pedidos/<%= o.id %>" class="text-ink hover:text-gold">n.º <%= o.id %></a>
              </td>
              <td class="whitespace-nowrap text-ink"><%= o.customer_name %></td>
              <td class="hidden whitespace-nowrap lg:table-cell"><%= o.customer_phone %></td>
              <td class="whitespace-nowrap"><%= new Date(o.created_at).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
              <td class="num"><%= money(o.total) %></td>
              <td><%- include('../partials/order-status', { status: o.status }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <p class="mt-5 text-xs text-sandDim"><%= orders.length %> <%= orders.length === 1 ? 'pedido' : 'pedidos' %> en esta vista.</p>

<%- include('../partials/admin-close') %>
</body>
</html>
