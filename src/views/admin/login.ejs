<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: 'Acceso administrador' }) %></head>
<body class="flex min-h-screen items-center justify-center bg-canopy px-6">
  <div class="w-full max-w-sm rounded-2xl border border-line bg-surface p-8">
    <div class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-leaf shadow-glow"></span>
      <span class="font-display text-lg font-bold tracking-widest">Arborea</span>
    </div>
    <p class="label-eyebrow mt-4">Panel de administrador</p>
    <h1 class="mt-1 text-2xl font-bold">Acceso restringido</h1>

    <% if (error) { %>
      <p class="mt-4 rounded-lg border border-danger/40 bg-danger/10 px-4 py-3 text-sm text-danger"><%= error %></p>
    <% } %>

    <form action="/admin/ingresar" method="POST" class="mt-6 space-y-4">
      <input type="email" name="email" required placeholder="Correo de administrador" class="input-field" />
      <input type="password" name="password" required placeholder="Contraseña" class="input-field" />
      <button type="submit" class="btn-primary w-full justify-center">Ingresar</button>
    </form>
    <a href="/" class="mt-6 block text-center text-xs text-moss hover:text-ink">← Volver a la tienda</a>
  </div>
</body>
</html>
