<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: 'Acceso administrador' }) %></head>
<body class="flex min-h-screen items-center justify-center bg-night px-6">
  <div class="w-full max-w-sm">
    <div class="flex items-center gap-3">
      <span class="h-1.5 w-1.5 rounded-full bg-gold" aria-hidden="true"></span>
      <span class="font-display text-base tracking-[0.32em] text-ink">ARBÓREA</span>
      <span class="ml-auto text-[10px] uppercase tracking-wander text-sandDim">Admin</span>
    </div>

    <h1 class="mt-10 font-display text-4xl text-ink">Acceso restringido</h1>

    <% if (error) { %>
      <p class="admin-note admin-note-danger mt-6" role="alert"><%= error %></p>
    <% } %>

    <form action="/admin/ingresar" method="POST" class="mt-10 space-y-6">
<%- include('../partials/csrf') %>
      <div>
        <label for="email" class="admin-label">Correo</label>
        <input id="email" type="email" name="email" required autocomplete="email" class="admin-field" />
      </div>
      <div>
        <label for="password" class="admin-label">Contraseña</label>
        <input id="password" type="password" name="password" required autocomplete="current-password" class="admin-field" />
      </div>
      <button type="submit" class="admin-btn w-full">Ingresar</button>
    </form>

    <a href="/" class="mt-10 block text-[10px] uppercase tracking-wander text-sandDim transition-colors hover:text-ink">
      ← Volver a la tienda
    </a>
  </div>
</body>
</html>
