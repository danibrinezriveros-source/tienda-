<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { title: 'Catálogo' }) %></head>
<body>
<%- include('../partials/admin-nav', { active: 'productos' }) %>

  <div class="flex flex-wrap items-center justify-between gap-5">
    <h1 class="admin-title">Catálogo</h1>
    <a href="/admin/productos/nuevo" class="admin-btn">Nuevo producto</a>
  </div>

  <%
    // El aviso se arma aquí a partir de un código conocido, nunca imprimiendo
    // lo que venga en la URL: así una dirección manipulada no puede poner texto
    // ajeno dentro del panel.
    var AVISOS = {
      creado: ['ok', 'Producto creado.'],
      actualizado: ['ok', 'Cambios guardados correctamente.'],
      retirado: ['ok', 'Producto retirado del catálogo. Sigue en el historial de pedidos y puedes volver a activarlo desde Editar.'],
      sin_archivo: ['warn', 'No llegó ningún archivo.'],
      csv_archivo_invalido: ['warn', 'No pudimos leer ese archivo: debe ser un CSV de menos de 2 MB.']
    };
    var aviso = AVISOS[ok] || null;
    if (!aviso && typeof ok === 'string') {
      var m = ok.match(/^importados_([0-9]{1,5})$/);
      if (m) aviso = ['ok', 'Se importaron ' + m[1] + ' productos.'];
      var f = ok.match(/^csv_fila_([0-9]{1,5})_(sin_nombre|precio_invalido|stock_invalido)$/);
      if (f) {
        var motivo = { sin_nombre: 'no tiene nombre', precio_invalido: 'tiene un precio inválido', stock_invalido: 'tiene un stock inválido' }[f[2]];
        aviso = ['warn', 'No se importó nada: la fila ' + f[1] + ' del archivo ' + motivo + '. Corrígela y vuelve a subirlo.'];
      }
      var t = ok.match(/^csv_demasiadas_filas_([0-9]{1,6})$/);
      if (t) aviso = ['warn', 'El archivo supera las ' + t[1] + ' filas permitidas por importación.'];
    }
  %>
  <% if (aviso) { %>
    <p class="admin-note admin-note-<%= aviso[0] %> mt-6" role="status"><%= aviso[1] %></p>
  <% } %>

  <details class="admin-panel mt-8 p-6">
    <summary class="cursor-pointer text-sm text-ink marker:text-gold">Carga masiva por CSV</summary>
    <p class="mt-4 text-sm leading-relaxed text-sandDim">
      El archivo debe traer estas columnas, en este orden:
      <code class="admin-code">name,description,price,stock,category,tags,image_url</code>
    </p>
    <form action="/admin/productos/importar" method="POST" enctype="multipart/form-data"
          class="mt-5 flex flex-wrap items-center gap-4">
<%- include('../partials/csrf') %>
      <label for="csv" class="sr-only">Archivo CSV</label>
      <input id="csv" type="file" name="csv" accept=".csv" required class="admin-file max-w-sm" />
      <button type="submit" class="admin-btn-ghost">Importar</button>
    </form>
  </details>

  <div class="admin-panel mt-8 overflow-x-auto">
    <% if (products.length === 0) { %>
      <p class="px-5 py-16 text-center text-sm text-sandDim">
        Todavía no has cargado productos.
        <a href="/admin/productos/nuevo" class="text-gold hover:underline">Crea el primero</a>.
      </p>
    <% } else { %>
      <table class="admin-table">
        <caption class="sr-only">Productos del catálogo</caption>
        <thead>
          <tr>
            <th scope="col">Producto</th>
            <th scope="col" class="hidden lg:table-cell">Categoría</th>
            <th scope="col" class="!text-right">Precio</th>
            <th scope="col" class="!text-right">Stock</th>
            <th scope="col">Estado</th>
            <th scope="col"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function (p) { %>
            <tr>
              <td class="text-ink">
                <a href="/admin/productos/<%= p.id %>/editar" class="hover:text-gold"><%= p.name %></a>
              </td>
              <td class="hidden whitespace-nowrap lg:table-cell"><%= p.category %></td>
              <td class="num"><%= money(p.price) %></td>
              <td class="num <%= p.stock <= 0 ? 'is-alert' : '' %>"><%= p.stock %></td>
              <td>
                <% if (p.active) { %>
                  <span class="badge badge-ok">Activo</span>
                <% } else { %>
                  <span class="badge badge-mute">Oculto</span>
                <% } %>
              </td>
              <td class="whitespace-nowrap text-right">
                <a href="/admin/productos/<%= p.id %>/editar" class="text-[10px] uppercase tracking-wander text-gold hover:underline">Editar</a>
                <form action="/admin/productos/<%= p.id %>/eliminar" method="POST" class="ml-4 inline"
                      data-confirm="¿Retirar «<%= p.name %>» del catálogo? Deja de verse en la tienda y en los anuncios; los pedidos que ya lo incluyen no cambian.">
<%- include('../partials/csrf') %>
                  <button class="text-[10px] uppercase tracking-wander text-sandDim transition-colors hover:text-danger">Retirar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <p class="mt-5 text-xs text-sandDim"><%= products.length %> <%= products.length === 1 ? 'producto' : 'productos' %> en total.</p>

<%- include('../partials/admin-close') %>
</body>
</html>
