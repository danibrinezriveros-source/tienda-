<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Recuperar contraseña' }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-sm px-6 pb-24 pt-36 sm:px-10">
    <h1 class="font-display text-5xl leading-[1.05] text-ink">Recuperar el acceso</h1>

    <% if (sent) { %>
      <p class="mt-8 border-l-2 border-gold pl-4 text-sm leading-relaxed text-sand" role="status">
        Si ese correo tiene una cuenta aquí, acabamos de enviarle un enlace para elegir una
        contraseña nueva. Vence en una hora y solo sirve una vez.
      </p>
      <p class="mt-6 text-sm leading-relaxed text-sandDim">
        Si no llega, mira en la carpeta de correo no deseado. También puedes
        <a href="/contacto" class="text-gold hover:underline">escribirnos</a> y lo resolvemos por WhatsApp.
      </p>
      <p class="mt-10 text-sm text-sandDim">
        <a href="/ingresar" class="text-gold hover:underline">Volver a entrar</a>
      </p>
    <% } else { %>
      <p class="mt-6 text-sm font-light leading-relaxed text-sand">
        Escribe el correo con el que creaste tu cuenta y te enviamos un enlace para elegir
        una contraseña nueva.
      </p>

      <% if (error) { %>
        <p class="mt-8 border-l-2 border-danger pl-4 text-sm text-danger" role="alert"><%= error %></p>
      <% } %>

      <form action="/recuperar" method="POST" class="mt-12 space-y-8">
<%- include('./partials/csrf') %>
        <div>
          <label for="email" class="mb-2 block text-[10px] uppercase tracking-wander text-sandDim">Correo</label>
          <input id="email" type="email" name="email" required autocomplete="email" class="field" />
        </div>
        <button type="submit" class="action-solid !flex w-full">Enviarme el enlace</button>
      </form>

      <p class="mt-10 text-sm text-sandDim">
        <a href="/ingresar" class="text-gold hover:underline">Ya la recordé</a>
      </p>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
