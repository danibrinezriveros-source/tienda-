<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Encuentra tu planta' }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-2xl px-6 pb-24 pt-32 sm:px-10">
    <h1 class="font-display text-5xl leading-[1.05] text-ink sm:text-6xl">Encuentra tu planta</h1>
    <p class="mt-6 max-w-md text-sm leading-relaxed text-sand">
      Tres preguntas y te decimos cuáles se ajustan a tu espacio — y por qué.
    </p>

    <form action="/asistente" method="POST" class="mt-16 space-y-14">
<%- include('./partials/csrf') %>
      <fieldset>
        <legend class="text-[10px] uppercase tracking-wander text-sandDim">Tu presupuesto</legend>
        <div class="mt-5 flex flex-wrap gap-3">
          <% budgetOptions.forEach(function (b) { %>
            <label class="relative inline-flex cursor-pointer">
              <input type="radio" name="budget" value="<%= b.value %>" class="peer absolute inset-0 h-full w-full cursor-pointer opacity-0" <%= answers.budget === b.value ? 'checked' : '' %> required />
              <span class="choice"><%= b.label %></span>
            </label>
          <% }) %>
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-[10px] uppercase tracking-wander text-sandDim">Qué tipo buscas</legend>
        <select name="category" class="field mt-5" required>
          <option value="">Selecciona una categoría</option>
          <% categories.forEach(function (c) { %>
            <option value="<%= c.category %>" <%= answers.category === c.category ? 'selected' : '' %>><%= c.category %></option>
          <% }) %>
        </select>
      </fieldset>

      <fieldset>
        <legend class="text-[10px] uppercase tracking-wander text-sandDim">Qué te importa más</legend>
        <div class="mt-5 flex flex-wrap gap-3">
          <% priorityOptions.forEach(function (p) { %>
            <label class="relative inline-flex cursor-pointer">
              <input type="radio" name="priority" value="<%= p.value %>" class="peer absolute inset-0 h-full w-full cursor-pointer opacity-0" <%= answers.priority === p.value ? 'checked' : '' %> required />
              <span class="choice"><%= p.label %></span>
            </label>
          <% }) %>
        </div>
      </fieldset>

      <button type="submit" class="action-solid">Recomiéndame</button>
    </form>

    <% if (results) { %>
      <div class="mt-24 border-t border-line pt-14">
        <h2 class="font-display text-3xl text-ink">Esto se ajusta a ti</h2>

        <% if (results.length === 0) { %>
          <p class="mt-6 text-sm leading-relaxed text-sand">
            No encontramos coincidencias exactas. Prueba ajustando el presupuesto o la categoría.
          </p>
        <% } else { %>
          <div class="mt-10">
            <% results.forEach(function (r) { %>
              <a href="/producto/<%= r.id %>" class="specimen-row group">
                <span class="specimen-thumb">
                  <%- include('partials/product-image', { image_url: r.image_url, name: r.name, category: r.category, pid: r.id }) %>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-display text-xl leading-tight text-ink transition-colors duration-500 group-hover:text-gold"><%= r.name %></span>
                  <span class="mt-1 block text-sm text-sandDim"><%= r.why %></span>
                </span>
                <span class="shrink-0 text-sm text-sand">
                  <%= money(r.price) %>
                </span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
