<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Mis pedidos' }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-4xl px-6 py-14">
    <span class="label-eyebrow">Historial</span>
    <h1 class="mt-2 text-3xl font-bold">Mis pedidos</h1>

    <% if (orders.length === 0) { %>
      <p class="mt-8 text-moss">Aún no tienes pedidos.</p>
    <% } else { %>
      <div class="mt-8 divide-y divide-line rounded-2xl border border-line bg-surface">
        <% orders.forEach(o => { %>
          <a href="/mis-pedidos/<%= o.id %>" class="flex items-center justify-between p-5 hover:bg-surface2">
            <div>
              <p class="font-medium">Pedido #<%= o.id %></p>
              <p class="text-sm text-moss"><%= new Date(o.created_at).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            </div>
            <div class="flex items-center gap-4">
              <span class="font-mono text-clay">$<%= Number(o.total).toFixed(2) %></span>
              <span class="status-pill bg-surface2 text-moss"><%= o.status %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
