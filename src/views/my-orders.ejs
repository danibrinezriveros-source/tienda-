<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Mis pedidos' }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-3xl px-6 pb-24 pt-32 sm:px-10">
    <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
      <h1 class="font-display text-5xl text-ink sm:text-6xl">Mis pedidos</h1>
      <a href="/cuenta/contrasena" class="quiet-link text-[10px] uppercase tracking-wander">Cambiar contraseña</a>
    </div>

    <% if (orders.length === 0) { %>
      <p class="mt-8 text-sm leading-relaxed text-sand">
        Aún no tienes pedidos.
        <a href="/" class="text-gold hover:underline">Empieza por el mundo</a>.
      </p>
    <% } else { %>
      <div class="mt-12">
        <% orders.forEach(function (o) { %>
          <a href="/mis-pedidos/<%= o.id %>" class="group flex items-baseline gap-6 border-b border-line/70 py-6 transition-colors duration-500 hover:border-gold/40">
            <span class="min-w-0 flex-1">
              <span class="block font-display text-2xl text-ink transition-colors duration-500 group-hover:text-gold">
                Pedido n.º <%= o.id %>
              </span>
              <span class="mt-1 block text-[11px] uppercase tracking-wander text-sandDim">
                <%= new Date(o.created_at).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                · <%= o.status %>
              </span>
            </span>
            <span class="shrink-0 text-sm text-sand">
              <%= money(o.total) %>
            </span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
