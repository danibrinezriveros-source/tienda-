<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Pedido #' + order.id }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-2xl px-6 pb-24 pt-32 sm:px-10">
    <%
      // Un pedido hecho sin cuenta no aparece en ninguna lista: existe mientras
      // dure esta visita y se confirma por WhatsApp. Mandarlo a "Mis pedidos"
      // sería mandarlo a un formulario de acceso.
    %>
    <% if (currentUser) { %>
      <a href="/mis-pedidos" class="quiet-link text-[11px] uppercase tracking-wander">← Mis pedidos</a>
    <% } else { %>
      <a href="/" class="quiet-link text-[11px] uppercase tracking-wander">← Volver al mundo</a>
    <% } %>

    <h1 class="mt-10 font-display text-5xl text-ink">Pedido n.º <%= order.id %></h1>
    <p class="mt-3 text-[11px] uppercase tracking-wander text-sandDim">
      <%= order.status %> · <%= new Date(order.created_at).toLocaleString('es-CO') %>
    </p>

    <div class="mt-12">
      <% items.forEach(function (i) { %>
        <div class="flex items-baseline gap-6 border-b border-line/70 py-5">
          <span class="min-w-0 flex-1">
            <span class="block font-display text-xl text-ink"><%= i.product_name %></span>
            <span class="mt-1 block text-[11px] uppercase tracking-wander text-sandDim">
              <%= i.quantity %> × <%= money(i.unit_price) %>
            </span>
          </span>
          <span class="shrink-0 text-sm text-sand">
            <%= money(i.unit_price * i.quantity) %>
          </span>
        </div>
      <% }) %>
    </div>

    <div class="mt-8 flex items-end justify-between border-t border-line pt-8">
      <span class="text-[11px] uppercase tracking-wander text-sandDim">Total</span>
      <span class="font-display text-3xl text-gold">
        <%= money(order.total) %>
      </span>
    </div>

    <p class="mt-8 text-sm leading-relaxed text-sand">
      Te escribimos por WhatsApp al <%= order.customer_phone %> para confirmar el pedido y
      cotizar el envío antes de despachar.
      <% if (!currentUser) { %>
        <span class="block text-sandDim">Guarda esta página: sin cuenta, es tu único enlace al pedido.</span>
      <% } %>
    </p>

    <dl class="mt-14 space-y-6 border-t border-line pt-10 text-sm">
      <div>
        <dt class="text-[10px] uppercase tracking-wander text-sandDim">Dirección</dt>
        <dd class="mt-2 leading-relaxed text-sand">
          <%= order.address %>
          <% if (order.city || order.region) { %>
            <span class="block text-sandDim"><%= [order.city, order.region].filter(Boolean).join(', ') %></span>
          <% } %>
        </dd>
      </div>
      <div>
        <dt class="text-[10px] uppercase tracking-wander text-sandDim">Teléfono</dt>
        <dd class="mt-2 text-sand"><%= order.customer_phone %></dd>
      </div>
    </dl>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
