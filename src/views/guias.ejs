<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Guías de cuidado' }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-3xl px-6 pt-32 sm:px-10">
    <h1 class="font-display text-5xl text-ink sm:text-6xl">Guías de cuidado</h1>
    <p class="mt-6 max-w-md text-sm leading-relaxed text-sand">
      Lo esencial para que tus plantas prosperen, sin tecnicismos. Si tu duda es sobre una
      especie concreta, el <a href="/asistente" class="text-gold hover:underline">asistente</a>
      afina más.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-24 pt-16 sm:px-10">
    <% guides.forEach(function (g, gi) { %>
      <article id="<%= g.slug %>" class="scroll-mt-28 border-t border-line py-14">
        <span class="text-[10px] uppercase tracking-wander text-sandDim"><%= String(gi + 1).padStart(2, '0') %></span>
        <h2 class="mt-4 font-display text-3xl text-ink sm:text-4xl"><%= g.title %></h2>
        <p class="mt-4 max-w-lg text-base font-light leading-relaxed text-sand"><%= g.summary %></p>
        <ul class="mt-10 space-y-5">
          <% g.tips.forEach(function (tip) { %>
            <li class="flex gap-5 text-sm leading-relaxed text-sand">
              <span class="mt-2 h-px w-6 shrink-0 bg-gold/60" aria-hidden="true"></span>
              <span><%= tip %></span>
            </li>
          <% }) %>
        </ul>
      </article>
    <% }) %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
