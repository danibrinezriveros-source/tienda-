<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: null }) %></head>
<body>
<!--
  THESIS: Arbórea no es una tienda que muestra plantas — es un mundo de ecosistemas que
    contiene una tienda. El visitante se pregunta "¿dónde estoy?" antes de "¿qué compro?".
  OWN-WORLD: un diorama isométrico. Cada ecosistema es una isla en perspectiva 2:1, con
    su propio suelo, luz y atmósfera; las plantas del catálogo la habitan como objetos
    anclados al terreno. Verdes profundos sobre negro suave, luz cálida cenital.
    Cormorant Garamond para la voz, Jost en versalitas espaciadas para la interfaz.
  STORY: el visitante entra a la selva, descubre que las plantas que la habitan tienen
    nombre y precio, y entiende que puede recorrer otros ecosistemas.
  FIRST VIEWPORT: la selva en penumbra, sin hero ni botón de compra. Wordmark limpio,
    una línea ("Plantas que encuentran su lugar") y un indicador discreto de exploración.
  FORM: mundo isométrico por ecosistemas — dirección pedida por el usuario (2026-08-26).
    Esta entrega es la prueba de concepto de un solo bioma: la selva.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish
    review, the verdict, and DESIGN.md rewritten from the built world.
-->
  <%- include('partials/header', { overlay: !isBrowsing }) %>

  <% if (!isBrowsing && biomes) { %>
    <!-- ——— Entrada: estás dentro del vivero ——— -->
    <section class="scene flex items-center justify-center" data-scene>
      <div class="scene-layer" data-depth="0.12"><%- include('partials/foliage', { key: 'dosel', band: 'far' }) %></div>
      <div class="scene-layer drift-slower" data-depth="0.34"><%- include('partials/foliage', { key: 'medio', band: 'mid' }) %></div>
      <div class="scene-layer drift-slow" data-depth="0.62"><%- include('partials/foliage', { key: 'suelo', band: 'near' }) %></div>
      <div class="scene-light" data-depth="0.2"><%- include('partials/light', { id: 'entrada', warm: 0.22 }) %></div>
      <div class="scene-layer scene-foreground" data-depth="0.95"><%- include('partials/veil', { tone: '#16281e' }) %></div>

      <div class="relative z-[10] px-6 text-center">
        <h1 class="font-display text-[13vw] leading-none tracking-[0.3em] text-ink sm:text-7xl lg:text-8xl" data-enter>
          ARBÓREA
        </h1>
        <p class="mx-auto mt-8 max-w-sm text-sm font-light leading-relaxed text-sand" data-enter="2">
          Plantas que encuentran su lugar.
        </p>
      </div>

      <a href="#entrada" class="absolute inset-x-0 bottom-10 z-[10] mx-auto flex w-max flex-col items-center gap-3 text-sand transition-colors duration-500 hover:text-ink" data-enter="3">
        <span class="text-[10px] uppercase tracking-wander">Explorar</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-4 drift-slow" viewBox="0 0 16 32" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
          <path stroke-linecap="round" d="M8 4v24M3 22l5 6 5-6" />
        </svg>
      </a>
    </section>

    <!-- ——— La entrada: hoy el mundo se abre por un bioma, y solo por uno ——— -->
    <% var world = biomes.filter(function (bm) { return bm.total > 0; }); %>
    <% if (entrance) { %>
      <%- include('partials/approach', { biome: entrance, shots: entranceShots }) %>
    <% } %>

    <!-- ——— El mundo: los ecosistemas se recorren de lado ——— -->
    <section id="mundo" class="relative scroll-mt-24 border-t border-line bg-night py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 sm:px-10">
        <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
          <nav class="world-menu" id="world-menu" aria-label="Ecosistemas">
            <% world.forEach(function (bm, bi) { %>
              <a href="#bioma-<%= bm.key %>" data-goto="<%= bi %>"
                 <%= bi === 0 ? 'aria-current="true"' : '' %>><%= bm.name %></a>
            <% }) %>
          </nav>

          <div class="flex items-center gap-3" id="world-steps" hidden>
            <button type="button" class="world-step" data-step="-1" aria-label="Ecosistema anterior">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" />
              </svg>
            </button>
            <button type="button" class="world-step" data-step="1" aria-label="Ecosistema siguiente">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="world-track mt-12" id="world-track" tabindex="0"
           aria-label="Mapa de ecosistemas — desplázate de lado para recorrerlo">
        <% world.forEach(function (bm, bi) { %>
          <article id="bioma-<%= bm.key %>" class="world-panel" data-biome="<%= bi %>"
                   aria-label="<%= bm.name %>">
            <div class="mx-auto max-w-6xl px-6 sm:px-10">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <span class="stratum-index">
                    Ecosistema <%= String(bi + 1).padStart(2, '0') %> de <%= world.length %> · <%= bm.total %> especies
                  </span>
                  <h2 class="mt-3 font-display text-4xl text-ink sm:text-5xl"><%= bm.name %></h2>
                  <p class="mt-3 max-w-sm text-sm leading-relaxed text-sand"><%= bm.line %></p>
                </div>
                <% if (bi === 0) { %>
                  <p class="max-w-[15rem] text-[11px] uppercase leading-relaxed tracking-wander text-sandDim">
                    Acércate a una planta para saber quién es. Pulsa la isla para verlas todas.
                  </p>
                <% } %>
              </div>

              <div class="iso-world mt-8">
                <%- include('partials/biome', { biome: bm }) %>
              </div>

              <p class="mt-6 text-sm text-sandDim">
                <% if (bm.total > bm.shown) { %>
                  Aquí crecen <%= bm.total %> especies; la isla muestra <%= bm.shown %>.
                <% } else { %>
                  Aquí crecen <%= bm.total %>
                  <%= bm.total === 1 ? 'especie' : 'especies' %>, todas a la vista.
                <% } %>
                <% bm.categories.forEach(function (cat, ci) { %><a href="/?category=<%= encodeURIComponent(cat) %>" class="text-gold hover:underline"><%= cat %></a><%= ci < bm.categories.length - 1 ? ' · ' : '' %><% }) %>
              </p>

              <!-- La isla ya es pulsable; esto lo dice en voz alta, y da un
                   destino al teclado sin tener que atravesar las plantas. -->
              <a href="<%= bm.href %>" class="action mt-8">
                Entrar <%= bm.into %>
              </a>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- ——— El índice: acceso completo al catálogo, sin cuadrícula ——— -->
  <section id="indice" class="relative border-t border-line bg-night <%= isBrowsing ? 'pt-32' : 'pt-24' %> pb-24">
    <div class="mx-auto max-w-4xl px-6 sm:px-10">
      <div class="border-b border-line pb-10">
        <h2 class="font-display text-4xl text-ink sm:text-5xl">El índice</h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-sand">
          Todo lo que crece en Arbórea, en una sola lista. <%= products.length %>
          <%= products.length === 1 ? 'especie disponible' : 'especies disponibles' %>.
        </p>

        <form class="mt-10 flex flex-col gap-6 sm:flex-row sm:items-end" method="GET" action="/">
          <div class="flex-1">
            <label for="q" class="mb-2 block text-[10px] uppercase tracking-wander text-sandDim">Buscar</label>
            <input id="q" type="text" name="q" value="<%= q %>" placeholder="Nombre de la planta…" class="field" />
          </div>
          <!-- Si el visitante entró por una isla, buscar dentro de ella no
               debe sacarlo del ecosistema. -->
          <% activeCategories.forEach(function (c) { %><input type="hidden" name="category" value="<%= c %>" /><% }) %>
          <button type="submit" class="action shrink-0">Buscar</button>
        </form>

        <% if (categories.length > 0) { %>
          <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 text-[11px] uppercase tracking-wander">
            <a href="/" class="<%= activeCategories.length === 0 ? 'text-gold' : 'quiet-link' %>">Todas</a>
            <% categories.forEach(function (c) { %>
              <a href="/?category=<%= encodeURIComponent(c.category) %>"
                 class="<%= activeCategories.indexOf(c.category) !== -1 ? 'text-gold' : 'quiet-link' %>"><%= c.category %></a>
            <% }) %>
          </div>
        <% } %>
      </div>

      <% if (products.length === 0) { %>
        <p class="py-20 text-center text-sm text-sand">
          Nada crece con ese filtro todavía. <a href="/" class="text-gold hover:underline">Vuelve al mundo</a>.
        </p>
      <% } else { %>
        <div class="mt-2">
          <% products.forEach(function (p) { %>
            <a href="/producto/<%= p.id %>" class="specimen-row group">
              <span class="specimen-thumb">
                <%- include('partials/product-image', { image_url: p.image_url, name: p.name, category: p.category, pid: p.id }) %>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-display text-xl leading-tight text-ink transition-colors duration-500 group-hover:text-gold"><%= p.name %></span>
                <span class="mt-1 block truncate text-sm text-sandDim"><%= p.description %></span>
              </span>
              <span class="shrink-0 text-right">
                <span class="block text-sm text-sand">$<%= Number(p.price).toLocaleString('es-CO', { maximumFractionDigits: 0 }) %></span>
                <% if (p.stock <= 0) { %>
                  <span class="mt-1 block text-[10px] uppercase tracking-wander text-sandDim">Agotada</span>
                <% } %>
              </span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <% if (typeof featuredGuides !== 'undefined' && featuredGuides.length > 0) { %>
    <section class="border-t border-line bg-deep py-24">
      <div class="mx-auto max-w-4xl px-6 sm:px-10">
        <h2 class="font-display text-3xl text-ink sm:text-4xl">Antes de llevártela</h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-sand">
          Una planta sobrevive si sabes de dónde viene. Esto es lo esencial.
        </p>
        <div class="mt-12 space-y-px">
          <% featuredGuides.forEach(function (g) { %>
            <a href="/guias#<%= g.slug %>" class="group flex items-baseline gap-6 border-b border-line/70 py-6 transition-colors duration-500 hover:border-gold/40">
              <span class="font-display text-2xl text-ink transition-colors duration-500 group-hover:text-gold"><%= g.title %></span>
              <span class="hidden flex-1 text-sm text-sandDim sm:block"><%= g.summary %></span>
            </a>
          <% }) %>
        </div>
        <a href="/guias" class="action mt-12">Todas las guías</a>
      </div>
    </section>
  <% } %>

  <%- include('partials/footer') %>
</body>
</html>
