<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Inicio' }) %></head>
<body>
  <%- include('partials/header', { transparent: true }) %>

  <section class="relative flex min-h-[92vh] items-center justify-center overflow-hidden bg-night">
    <img
      src="https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=1920&q=80"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-night/80 via-night/50 to-night/85"></div>

    <div class="relative z-10 mx-auto max-w-2xl px-6 text-center">
      <span class="label-eyebrow-hero">Vivero online · plantas con alma</span>
      <h1 class="mt-6 font-display text-5xl font-extrabold uppercase leading-[1.05] tracking-[0.04em] text-cream md:text-7xl">
        Arborea
      </h1>
      <p class="mx-auto mt-6 max-w-lg text-base leading-relaxed text-cream/85 md:text-lg">
        Elegimos cada planta pensando en que sobreviva a tu ritmo de vida, no solo a la foto.
        Llega con su guía de cuidado, y si no sabes por dónde empezar, nuestro asistente te
        recomienda justo lo que tu espacio necesita.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="#catalogo" class="btn-primary">Explorar catálogo</a>
        <a href="/asistente" class="btn-secondary !border-cream/30 !bg-cream/10 !text-cream hover:!border-cream/60 hover:!bg-cream/15">Encuentra tu planta</a>
      </div>
    </div>

    <div class="absolute inset-x-0 bottom-8 z-10 hidden justify-center sm:flex">
      <a href="#catalogo" class="flex flex-col items-center gap-2 text-cream/70 transition hover:text-cream">
        <span class="font-mono text-[10px] uppercase tracking-[0.3em]">Descubre más</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </section>

  <section class="border-y border-line bg-surface2/50">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-6 py-12 sm:grid-cols-4">
      <div class="text-center">
        <p class="text-2xl">🌿</p>
        <p class="mt-2 text-sm font-medium">Cultivadas con cuidado</p>
      </div>
      <div class="text-center">
        <p class="text-2xl">📋</p>
        <p class="mt-2 text-sm font-medium">Guía de cuidado incluida</p>
      </div>
      <div class="text-center">
        <p class="text-2xl">🚚</p>
        <p class="mt-2 text-sm font-medium">Empacadas para el viaje</p>
      </div>
      <div class="text-center">
        <p class="text-2xl">💬</p>
        <p class="mt-2 text-sm font-medium">Asesoría personalizada</p>
      </div>
    </div>
  </section>

  <% if (categories.length > 0) { %>
    <section class="mx-auto max-w-6xl px-6 py-14">
      <span class="label-eyebrow">Explora</span>
      <h2 class="section-heading mt-2">Busca por categoría</h2>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/" class="tag-chip <%= activeCategory === '' ? '!border-leaf !text-leaf' : '' %>">Todas</a>
        <% categories.forEach(c => { %>
          <a href="/?category=<%= encodeURIComponent(c.category) %>"
             class="tag-chip <%= activeCategory === c.category ? '!border-leaf !text-leaf' : '' %>"><%= c.category %></a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section id="catalogo" class="mx-auto max-w-6xl px-6 py-8">
    <div class="flex flex-col gap-6 border-b border-line pb-8 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="label-eyebrow">Catálogo</span>
        <h2 class="section-heading mt-2">Plantas disponibles</h2>
      </div>

      <form class="flex flex-wrap items-center gap-3" method="GET" action="/">
        <input type="text" name="q" value="<%= q %>" placeholder="Buscar planta…" class="input-field !w-56" />
        <select name="category" class="input-field !w-44" onchange="this.form.submit()">
          <option value="">Todas las categorías</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.category %>" <%= activeCategory === c.category ? 'selected' : '' %>><%= c.category %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn-secondary !px-4 !py-2 text-xs">Filtrar</button>
      </form>
    </div>

    <% if (products.length === 0) { %>
      <p class="mt-12 text-center text-moss">No encontramos plantas con ese filtro. Prueba con otra búsqueda.</p>
    <% } else { %>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% products.forEach(p => { %>
          <a href="/producto/<%= p.id %>" class="card group flex flex-col overflow-hidden">
            <div class="aspect-[4/3] overflow-hidden bg-surface2">
              <% if (p.image_url) { %>
                <img src="<%= p.image_url %>" alt="<%= p.name %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <% } %>
            </div>
            <div class="flex flex-1 flex-col gap-2 p-5">
              <span class="label-eyebrow"><%= p.category %></span>
              <h3 class="text-lg font-semibold"><%= p.name %></h3>
              <p class="line-clamp-2 text-sm text-moss"><%= p.description %></p>
              <div class="mt-auto flex items-center justify-between pt-3">
                <span class="font-mono text-xl font-semibold text-clay">$<%= Number(p.price).toFixed(2) %></span>
                <% if (p.stock > 0) { %>
                  <span class="status-pill bg-ok/10 text-ok"><span class="h-1.5 w-1.5 rounded-full bg-ok"></span> Disponible</span>
                <% } else { %>
                  <span class="status-pill bg-danger/10 text-danger"><span class="h-1.5 w-1.5 rounded-full bg-danger"></span> Agotada</span>
                <% } %>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <% if (typeof featuredGuides !== 'undefined' && featuredGuides.length > 0) { %>
    <section class="mx-auto max-w-6xl px-6 py-16">
      <div class="flex flex-col gap-2 border-b border-line pb-8 md:flex-row md:items-end md:justify-between">
        <div>
          <span class="label-eyebrow">Aprende</span>
          <h2 class="section-heading mt-2">Guías de cuidado</h2>
        </div>
        <a href="/guias" class="text-sm text-clay hover:underline">Ver todas las guías →</a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
        <% featuredGuides.forEach(g => { %>
          <a href="/guias#<%= g.slug %>" class="card flex flex-col gap-3 p-6">
            <span class="text-3xl"><%= g.icon %></span>
            <h3 class="text-lg font-semibold"><%= g.title %></h3>
            <p class="text-sm text-moss"><%= g.summary %></p>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="bg-leaf">
    <div class="mx-auto max-w-6xl px-6 py-16 text-cream">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
        <div>
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-cream/70">Nuestro compromiso</span>
          <h2 class="mt-3 font-display text-2xl font-semibold">Verde de verdad, de principio a fin</h2>
        </div>
        <div>
          <p class="font-semibold">Origen responsable</p>
          <p class="mt-2 text-sm text-cream/80">Trabajamos con productores locales y evitamos especies de origen incierto o en riesgo.</p>
        </div>
        <div>
          <p class="font-semibold">Menos plástico</p>
          <p class="mt-2 text-sm text-cream/80">Reutilizamos empaques cuando podemos y preferimos materiales biodegradables en el envío.</p>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
