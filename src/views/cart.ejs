<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Carrito' }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-3xl px-6 pb-24 pt-32 sm:px-10">
    <h1 class="font-display text-5xl text-ink sm:text-6xl">Lo que te llevas</h1>

    <%
      // Lo que cambió en la tienda mientras el carrito esperaba. Se dice aquí,
      // antes de pedir un solo dato, y no dentro del checkout: el cliente
      // todavía puede reaccionar.
    %>
    <% if (notices && notices.length) { %>
      <div class="notice mt-10" role="status">
        <p class="stratum-index !text-warn">El vivero cambió mientras tanto</p>
        <ul class="mt-4 space-y-2 text-sm leading-relaxed text-sand">
          <% notices.forEach(function (n) { %>
            <li><%= n %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (cart.length === 0) { %>
      <p class="mt-8 text-sm leading-relaxed text-sand">
        Todavía no has recogido nada.
        <a href="/" class="text-gold hover:underline">Vuelve al mundo</a> y acércate a una planta.
      </p>
    <% } else { %>
      <div class="mt-12">
        <% cart.forEach(function (item) { %>
          <%
            // En un teléfono la línea se dobla en dos: arriba la planta y su
            // cantidad, abajo lo que suma y la salida. En pantalla ancha las
            // cuatro cosas caben en una sola fila.
          %>
          <div class="grid grid-cols-[1fr_auto] items-start gap-x-6 gap-y-5 border-b border-line/70 py-6
                      last:border-b-0 sm:grid-cols-[1fr_auto_6rem_auto] sm:items-center sm:gap-y-0">
            <span class="min-w-0">
              <a href="/producto/<%= item.productId %>" class="block font-display text-2xl text-ink transition-colors duration-500 hover:text-gold">
                <%= item.name %>
              </a>
              <span class="mt-1 block text-[11px] uppercase tracking-wander text-sandDim">
                <%= money(item.price) %> cada una<% if (item.stock <= item.quantity) { %> · <span class="text-warn">es todo lo que queda</span><% } %>
              </span>
            </span>

            <%
              // La cantidad se corrige aquí mismo. Antes solo existía "quitar":
              // pasar de una planta a dos obligaba a borrar la línea y volver a
              // buscarla en el mundo. Sin JavaScript, cada paso es un envío del
              // formulario — el carrito nunca miente sobre lo que hay.
            %>
            <form action="/carrito/cantidad/<%= item.productId %>" method="POST" class="qty justify-self-end">
<%- include('./partials/csrf') %>
              <button type="submit" name="delta" value="-1" class="qty-step"
                      aria-label="Una <%= item.name %> menos">−</button>
              <label class="sr-only" for="qty-<%= item.productId %>">Cantidad de <%= item.name %></label>
              <input id="qty-<%= item.productId %>" class="qty-value" type="number" name="quantity"
                     value="<%= item.quantity %>" min="1" max="<%= item.stock %>" inputmode="numeric" />
              <button type="submit" name="delta" value="1" class="qty-step"
                      <%= item.quantity >= item.stock ? 'disabled' : '' %>
                      aria-label="Una <%= item.name %> más">+</button>
            </form>

            <span class="self-center text-sm text-sand sm:text-right">
              <%= money(item.price * item.quantity) %>
            </span>

            <form action="/carrito/quitar/<%= item.productId %>" method="POST" class="justify-self-end self-center">
<%- include('./partials/csrf') %>
              <button class="text-[10px] uppercase tracking-wander text-sandDim transition-colors duration-500 hover:text-danger">Quitar</button>
            </form>
          </div>
        <% }) %>
      </div>

      <div class="mt-10 flex items-end justify-between border-t border-line pt-8">
        <span class="text-[11px] uppercase tracking-wander text-sandDim">Total</span>
        <span class="font-display text-4xl text-gold">
          <%= money(total) %>
        </span>
      </div>
      <p class="mt-3 text-right text-[11px] uppercase tracking-wander text-sandDim">
        El envío se cotiza al confirmar por WhatsApp
      </p>

      <div class="mt-12 flex flex-wrap items-center gap-8">
        <a href="/checkout" class="action-solid">Continuar</a>
        <a href="/" class="quiet-link text-[11px] uppercase tracking-wander">Seguir explorando</a>
      </div>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
