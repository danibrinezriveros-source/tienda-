<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Carrito' }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-3xl px-6 pb-24 pt-32 sm:px-10">
    <h1 class="font-display text-5xl text-ink sm:text-6xl">Lo que te llevas</h1>

    <% if (cart.length === 0) { %>
      <p class="mt-8 text-sm leading-relaxed text-sand">
        Todavía no has recogido nada.
        <a href="/" class="text-gold hover:underline">Vuelve al mundo</a> y acércate a una planta.
      </p>
    <% } else { %>
      <div class="mt-12">
        <% cart.forEach(function (item) { %>
          <div class="flex items-baseline gap-6 border-b border-line/70 py-6">
            <span class="min-w-0 flex-1">
              <span class="block font-display text-2xl text-ink"><%= item.name %></span>
              <span class="mt-1 block text-[11px] uppercase tracking-wander text-sandDim">
                <%= item.quantity %> × $<%= Number(item.price).toLocaleString('es-CO', { maximumFractionDigits: 0 }) %>
              </span>
            </span>
            <span class="shrink-0 text-sm text-sand">
              $<%= (item.price * item.quantity).toLocaleString('es-CO', { maximumFractionDigits: 0 }) %>
            </span>
            <form action="/carrito/quitar/<%= item.productId %>" method="POST" class="shrink-0">
              <button class="text-[10px] uppercase tracking-wander text-sandDim transition-colors duration-500 hover:text-danger">Quitar</button>
            </form>
          </div>
        <% }) %>
      </div>

      <div class="mt-10 flex items-end justify-between border-t border-line pt-8">
        <span class="text-[11px] uppercase tracking-wander text-sandDim">Total</span>
        <span class="font-display text-4xl text-gold">
          $<%= total.toLocaleString('es-CO', { maximumFractionDigits: 0 }) %>
        </span>
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-8">
        <a href="/checkout" class="action-solid">Continuar</a>
        <a href="/" class="quiet-link text-[11px] uppercase tracking-wander">Seguir explorando</a>
      </div>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
