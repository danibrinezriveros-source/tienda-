<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Cambiar contraseña' }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-sm px-6 pb-24 pt-36 sm:px-10">
    <h1 class="font-display text-5xl leading-[1.05] text-ink">Cambiar la contraseña</h1>
    <p class="mt-6 text-sm font-light leading-relaxed text-sand">
      Al guardarla se cierran las demás sesiones abiertas con la anterior.
    </p>

    <% if (ok) { %>
      <p class="mt-8 border-l-2 border-gold pl-4 text-sm text-sand" role="status">
        Listo. Tu contraseña quedó cambiada y esta es la única sesión que sigue abierta.
      </p>
      <p class="mt-10 text-sm text-sandDim">
        <a href="/mis-pedidos" class="text-gold hover:underline">Volver a mis pedidos</a>
      </p>
    <% } else { %>
      <% if (error) { %>
        <p class="mt-8 border-l-2 border-danger pl-4 text-sm text-danger" role="alert"><%= error %></p>
      <% } %>

      <form action="/cuenta/contrasena" method="POST" class="mt-12 space-y-8">
<%- include('./partials/csrf') %>
        <div>
          <label for="current_password" class="mb-2 block text-[10px] uppercase tracking-wander text-sandDim">Contraseña actual</label>
          <input id="current_password" type="password" name="current_password" required
                 autocomplete="current-password" class="field" />
        </div>
        <div>
          <label for="new_password" class="mb-2 block text-[10px] uppercase tracking-wander text-sandDim">Nueva contraseña</label>
          <input id="new_password" type="password" name="new_password" required minlength="10"
                 autocomplete="new-password" class="field" />
          <p class="mt-2 text-xs text-sandDim">Mínimo 10 caracteres. Una frase larga es más segura que un símbolo raro.</p>
        </div>
        <div>
          <label for="confirm_password" class="mb-2 block text-[10px] uppercase tracking-wander text-sandDim">Repítela</label>
          <input id="confirm_password" type="password" name="confirm_password" required minlength="10"
                 autocomplete="new-password" class="field" />
        </div>
        <button type="submit" class="action-solid !flex w-full">Guardar</button>
      </form>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
