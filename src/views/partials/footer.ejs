    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-line pt-6 text-xs text-moss md:flex-row">
      <div class="flex items-center gap-2 font-mono">
        <span class="h-1.5 w-1.5 rounded-full bg-ok"></span>
        Catálogo actualizado
      </div>
      <p>© <%= new Date().getFullYear() %> Arborea. Cultivado con cuidado.</p>
    </div>
  </div>
</footer>
