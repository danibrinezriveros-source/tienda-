<%
  // Retrato ilustrado de una planta. El catálogo no tiene fotografías todavía
  // (todas las filas traen image_url vacío), así que cada especie se dibuja
  // según su categoría. Si algún día se cargan fotos reales, product-image.ejs
  // las usa y este dibujo queda como respaldo.
  var category = ((typeof category !== 'undefined' && category) || '').trim().toLowerCase();
  var pid = typeof pid !== 'undefined' ? Number(pid) || 0 : 0;
  // `bare` lo dibuja sin fondo ni viñeta, para incrustarlo como sprite dentro
  // de una escena mayor (el mundo isométrico).
  var bare = typeof bare !== 'undefined' && bare;
  // El nombre real distingue variantes dentro de una misma categoría
  // (un cactus barril no se dibuja como una roseta).
  var pname = (typeof name !== 'undefined' && name) ? String(name) : '';

  var seed = pid * 2654435761 % 2147483647;
  function rnd() { seed = (seed * 1103515245 + 12345) % 2147483648; return seed / 2147483648; }
  function span(a, b) { return a + rnd() * (b - a); }

  var DARK = '#24402c', MID = '#3f6a48', LIT = '#6d9a69', BARK = '#4a3a2a', BARKLIT = '#6b5540';
  var BLOOM = ['#c8a86a', '#b8695c', '#c9a24e', '#a9787f'];
  var bloom = BLOOM[pid % BLOOM.length];

  var s = [];

  // Lámina de hoja apuntando a la derecha, girada por transform.
  function blade(cx, cy, rot, len, wide, fill, op) {
    return '<g transform="translate(' + cx.toFixed(1) + ',' + cy.toFixed(1) + ') rotate(' + rot.toFixed(1) + ')" opacity="' + op + '">' +
      '<path d="M0 0 C ' + (len * 0.28).toFixed(1) + ' -' + wide.toFixed(1) + ', ' + (len * 0.72).toFixed(1) + ' -' + wide.toFixed(1) +
      ', ' + len.toFixed(1) + ' 0 C ' + (len * 0.72).toFixed(1) + ' ' + wide.toFixed(1) + ', ' + (len * 0.28).toFixed(1) + ' ' + wide.toFixed(1) + ', 0 0 Z" fill="' + fill + '"/>' +
      '<path d="M2 0 H ' + (len - 4).toFixed(1) + '" stroke="#000" stroke-opacity="0.16" stroke-width="1.6"/></g>';
  }

  if (category === 'palmeras') {
    s.push('<path d="M100 190 C 96 150 96 120 99 96 L 105 96 C 108 120 108 150 104 190 Z" fill="' + BARK + '"/>');
    for (var i = 0; i < 9; i++) {
      var a = -170 + i * 21 + span(-5, 5);
      var L = span(56, 80);
      s.push('<g transform="translate(102,96) rotate(' + a.toFixed(1) + ')">' +
        '<path d="M0 0 Q ' + (L * 0.55).toFixed(1) + ' -14 ' + L.toFixed(1) + ' -4" stroke="' + (i % 2 ? MID : LIT) + '" stroke-width="4" fill="none" stroke-linecap="round"/>');
      for (var f = 1; f < 7; f++) {
        var t = f / 7, px = t * L, py = -10 * Math.sin(t * 3.14) - t * 4;
        s.push('<path d="M' + px.toFixed(1) + ' ' + py.toFixed(1) + ' q 9 -10 15 -3 q -8 5 -15 3 Z" fill="' + (i % 2 ? MID : LIT) + '"/>');
      }
      s.push('</g>');
    }
  } else if (category === 'suculentas' && /cactus|mammillaria/i.test(pname)) {
    // Cactus: columna o barril con costillas y espinas.
    var barrel = /barril|mammillaria/i.test(pname);
    if (barrel) {
      s.push('<ellipse cx="100" cy="182" rx="46" ry="12" fill="#000" opacity="0.2"/>');
      s.push('<ellipse cx="100" cy="140" rx="46" ry="48" fill="' + MID + '"/>');
      s.push('<ellipse cx="88" cy="136" rx="30" ry="40" fill="' + LIT + '" opacity="0.55"/>');
      for (var rib = 0; rib < 7; rib++) {
        var rx0 = 62 + rib * 12.6;
        s.push('<path d="M' + rx0 + ' 104 Q ' + (rx0 + 2) + ' 140 ' + rx0 + ' 178" stroke="' + DARK + '" stroke-width="2" fill="none" opacity="0.5"/>');
      }
      s.push('<circle cx="100" cy="94" r="7" fill="' + bloom + '"/>');
    } else {
      s.push('<ellipse cx="100" cy="184" rx="38" ry="10" fill="#000" opacity="0.2"/>');
      s.push('<path d="M78 184 Q 74 116 100 100 Q 126 116 122 184 Z" fill="' + MID + '"/>');
      s.push('<path d="M86 182 Q 84 122 100 106 Q 108 126 106 182 Z" fill="' + LIT + '" opacity="0.5"/>');
      s.push('<path d="M78 150 Q 56 146 52 122 Q 66 124 78 138 Z" fill="' + MID + '"/>');
      s.push('<path d="M122 162 Q 146 158 150 136 Q 134 140 122 152 Z" fill="' + DARK + '"/>');
      for (var sp2 = 0; sp2 < 9; sp2++) {
        var sy = 112 + sp2 * 8;
        s.push('<path d="M80 ' + sy + ' l -7 -3 M120 ' + sy + ' l 7 -3" stroke="#e8dcae" stroke-width="1.6" opacity="0.65"/>');
      }
    }
  } else if (category === 'suculentas') {
    s.push('<ellipse cx="100" cy="176" rx="34" ry="9" fill="#000" opacity="0.22"/>');
    for (var r = 0; r < 3; r++) {
      var n = 8 - r * 1, rad = 52 - r * 15, col = r === 0 ? DARK : r === 1 ? MID : LIT;
      for (var k = 0; k < n; k++) {
        var ang = (360 / n) * k + r * 22;
        s.push('<g transform="translate(100,150) rotate(' + ang + ')">' +
          '<path d="M0 0 C 10 -' + (rad * 0.5).toFixed(1) + ' 8 -' + (rad * 0.86).toFixed(1) + ' 0 -' + rad.toFixed(1) +
          ' C -8 -' + (rad * 0.86).toFixed(1) + ' -10 -' + (rad * 0.5).toFixed(1) + ' 0 0 Z" fill="' + col + '"/></g>');
      }
    }
  } else if (category === 'aromáticas' || category === 'aromaticas') {
    s.push('<path d="M100 190 V104" stroke="' + MID + '" stroke-width="4" stroke-linecap="round"/>');
    for (var h = 0; h < 6; h++) {
      var hy = 176 - h * 15, hl = 26 + h * 2.5;
      s.push(blade(100, hy, -34 - h * 3, hl, 9, h % 2 ? MID : LIT, 0.95));
      s.push(blade(100, hy, 214 + h * 3, hl, 9, h % 2 ? LIT : MID, 0.95));
    }
    s.push('<circle cx="100" cy="98" r="7" fill="' + LIT + '"/>');
  } else if (category === 'árboles' || category === 'arboles') {
    s.push('<path d="M94 190 C 92 156 92 140 96 122 L 106 122 C 110 140 110 156 108 190 Z" fill="' + BARK + '"/>');
    s.push('<path d="M99 140 L 76 116 M103 134 L 128 112" stroke="' + BARKLIT + '" stroke-width="5" stroke-linecap="round"/>');
    s.push('<circle cx="100" cy="86" r="46" fill="' + DARK + '"/>');
    s.push('<circle cx="76" cy="100" r="30" fill="' + MID + '"/>');
    s.push('<circle cx="126" cy="98" r="27" fill="' + MID + '"/>');
    s.push('<circle cx="104" cy="70" r="28" fill="' + LIT + '" opacity="0.85"/>');
  } else if ((category === 'ornamentales' || category === 'exterior') &&
             /trepadora|bug[ai]mbilia|buganvilia|veranera|trinitaria|jazm|heliconia/i.test(pname)) {
    // Trepadora: tallo que sube y se abre en flor.
    s.push('<path d="M100 190 C 92 156 112 132 96 104 C 84 82 104 66 100 44" stroke="' + MID + '" stroke-width="5" fill="none" stroke-linecap="round"/>');
    for (var vl = 0; vl < 7; vl++) {
      var vy = 172 - vl * 19, vside = vl % 2 ? 1 : -1;
      s.push(blade(100 + vside * 4, vy, vside > 0 ? -22 : 202, 30, 11, vl % 2 ? MID : LIT, 0.95));
    }
    for (var fw = 0; fw < 9; fw++) {
      var fx2 = span(64, 136), fy2 = span(48, 150);
      s.push('<g transform="translate(' + fx2.toFixed(1) + ',' + fy2.toFixed(1) + ')">' +
        '<circle cx="0" cy="-5" r="5" fill="' + bloom + '"/><circle cx="5" cy="2" r="5" fill="' + bloom + '"/>' +
        '<circle cx="-5" cy="2" r="5" fill="' + bloom + '"/><circle cx="0" cy="0" r="2.4" fill="#e8dcae"/></g>');
    }
  } else if (category === 'ornamentales' || category === 'exterior') {
    s.push('<path d="M100 190 V128" stroke="' + BARK + '" stroke-width="5" stroke-linecap="round"/>');
    s.push('<path d="M62 158 Q 100 96 138 158 Z" fill="' + DARK + '"/>');
    s.push('<path d="M74 162 Q 100 116 126 162 Z" fill="' + MID + '"/>');
    s.push('<path d="M86 164 Q 100 134 114 164 Z" fill="' + LIT + '" opacity="0.9"/>');
    for (var b = 0; b < 7; b++) {
      var bx = span(70, 130), by = span(112, 156);
      s.push('<circle cx="' + bx.toFixed(1) + '" cy="' + by.toFixed(1) + '" r="' + span(4, 7).toFixed(1) + '" fill="' + bloom + '"/>');
    }
  } else if (category === 'macetas y accesorios') {
    s.push('<path d="M64 118 H136 L126 184 Q 100 190 74 184 Z" fill="' + BARKLIT + '"/>');
    s.push('<rect x="59" y="106" width="82" height="16" rx="4" fill="' + BARK + '"/>');
    s.push('<path d="M100 106 V78" stroke="' + MID + '" stroke-width="4" stroke-linecap="round"/>');
    s.push(blade(100, 92, -40, 30, 11, MID, 0.95));
    s.push(blade(100, 92, 220, 30, 11, LIT, 0.95));
    s.push(blade(100, 80, -18, 26, 9, LIT, 0.95));
  } else {
    // interior y todo lo demás: follaje ancho tipo monstera.
    s.push('<path d="M100 190 C 98 162 100 142 100 126" stroke="' + BARK + '" stroke-width="5" stroke-linecap="round"/>');
    var arr = [[-54, 82, 34, MID], [48, 80, 33, MID], [-22, 92, 38, LIT], [24, 88, 36, LIT], [0, 76, 31, '#8fbd87']];
    for (var m = 0; m < arr.length; m++) {
      var d = arr[m];
      s.push('<g transform="translate(100,126) rotate(' + d[0] + ')">' +
        '<path d="M0 0 C ' + (d[1] * 0.3) + ' -' + d[2] + ', ' + (d[1] * 0.74) + ' -' + d[2] + ', ' + d[1] + ' -6 C ' +
        (d[1] * 0.74) + ' ' + (d[2] - 4) + ', ' + (d[1] * 0.3) + ' ' + d[2] + ', 0 0 Z" fill="' + d[3] + '"/>' +
        '<path d="M' + (d[1] * 0.42) + ' -' + (d[2] * 0.52) + ' l 13 3 M' + (d[1] * 0.62) + ' -' + (d[2] * 0.4) + ' l 12 3" stroke="#0b120e" stroke-opacity="0.5" stroke-width="4" stroke-linecap="round"/>' +
        '</g>');
    }
  }
%>
<% if (bare) { %><%- s.join('') %><% } else { %>
<svg viewBox="0 0 200 200" class="h-full w-full" preserveAspectRatio="xMidYMid slice" role="img" aria-label="<%= typeof name !== 'undefined' ? name : 'Planta' %>">
  <rect width="200" height="200" fill="#16281e"/>
  <circle cx="100" cy="196" r="72" fill="#0e1a13" opacity="0.55"/>
  <%- s.join('') %>
</svg>
<% } %>
