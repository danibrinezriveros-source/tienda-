<%
  // Vegetación de una banda de profundidad dentro de una toma.
  // `key` = estrato (dosel / medio / suelo / jardin), `band` = lejos / medio / cerca.
  // Cuanto más cerca, más claro y más grande: así se lee la profundidad.
  var key = typeof key !== 'undefined' ? key : 'medio';
  var band = typeof band !== 'undefined' ? band : 'mid';

  var palette = {
    dosel:  { far: '#0e1a13', mid: '#16281e', near: '#243d2b' },
    medio:  { far: '#101c16', mid: '#1b3021', near: '#2f4f36' },
    suelo:  { far: '#121f19', mid: '#1f3525', near: '#33543a' },
    jardin: { far: '#17271d', mid: '#26412b', near: '#3f6543' }
  };
  var fill = (palette[key] || palette.medio)[band];

  // Generador determinista: la misma escena se dibuja igual en cada visita,
  // pero la distribución no queda en rejilla.
  var seed = key.length * 7919 + band.charCodeAt(0) * 104729 + key.charCodeAt(0) * 131;
  function rnd() {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 2147483648;
  }
  function span(min, max) { return min + rnd() * (max - min); }

  var out = [];

  // Hoja tropical simple: lámina asimétrica + nervadura central.
  function leaf(x, y, rot, s, op) {
    return '<g transform="translate(' + x.toFixed(1) + ',' + y.toFixed(1) + ') rotate(' +
      rot.toFixed(1) + ') scale(' + s.toFixed(3) + ')" opacity="' + op.toFixed(2) + '">' +
      '<path d="M0 0 C 44 -62 138 -74 202 -24 C 138 30 44 46 0 0 Z" fill="' + fill + '"/>' +
      '<path d="M8 -1 C 66 -18 140 -26 196 -25" stroke="#000" stroke-opacity="0.18" stroke-width="3" fill="none"/>' +
      '</g>';
  }

  // Fronda de helecho: raquis con folíolos a lado y lado.
  function frond(x, y, rot, s, op) {
    var g = '<g transform="translate(' + x.toFixed(1) + ',' + y.toFixed(1) + ') rotate(' +
      rot.toFixed(1) + ') scale(' + s.toFixed(3) + ')" opacity="' + op.toFixed(2) + '">' +
      '<path d="M0 0 C 70 -10 150 -26 220 -54" stroke="' + fill + '" stroke-width="6" fill="none" stroke-linecap="round"/>';
    for (var i = 0; i < 11; i++) {
      var t = i / 10;
      var px = 12 + t * 200;
      var py = -2 - t * 50;
      var len = 34 * (1 - t * 0.62);
      g += '<path d="M' + px.toFixed(1) + ' ' + py.toFixed(1) + ' q ' + len.toFixed(1) + ' -' +
        (len * 0.85).toFixed(1) + ' ' + (len * 1.25).toFixed(1) + ' -' + (len * 0.2).toFixed(1) +
        ' q -' + (len * 0.7).toFixed(1) + ' ' + (len * 0.7).toFixed(1) + ' -' + (len * 1.25).toFixed(1) +
        ' ' + (len * 0.2).toFixed(1) + ' Z" fill="' + fill + '"/>';
      g += '<path d="M' + px.toFixed(1) + ' ' + py.toFixed(1) + ' q ' + len.toFixed(1) + ' ' +
        (len * 0.85).toFixed(1) + ' ' + (len * 1.25).toFixed(1) + ' ' + (len * 0.2).toFixed(1) +
        ' q -' + (len * 0.7).toFixed(1) + ' -' + (len * 0.7).toFixed(1) + ' -' + (len * 1.25).toFixed(1) +
        ' -' + (len * 0.2).toFixed(1) + ' Z" fill="' + fill + '"/>';
    }
    return g + '</g>';
  }

  // Tronco con una rama: la vertical que sostiene el dosel.
  function trunk(x, w, lean, branchAt) {
    var g = '<g>';
    g += '<path d="M' + x + ' 900 C ' + (x + lean * 0.3) + ' 620, ' + (x + lean * 0.7) + ' 380, ' +
      (x + lean) + ' 0 L ' + (x + lean + w) + ' 0 C ' + (x + lean * 0.7 + w) + ' 380, ' +
      (x + lean * 0.3 + w) + ' 620, ' + (x + w) + ' 900 Z" fill="' + fill + '"/>';
    if (branchAt) {
      g += '<path d="M' + (x + lean * 0.6 + w * 0.5) + ' ' + branchAt + ' C ' +
        (x + lean + 190) + ' ' + (branchAt - 26) + ', ' + (x + lean + 330) + ' ' + (branchAt - 8) + ', ' +
        (x + lean + 470) + ' ' + (branchAt - 54) + '" stroke="' + fill + '" stroke-width="17" fill="none" stroke-linecap="round"/>';
    }
    return g + '</g>';
  }

  // Liana colgante: la verticalidad húmeda del trópico.
  function vine(x, len, sway) {
    var g = '<path d="M' + x + ' -10 C ' + (x + sway) + ' ' + (len * 0.32).toFixed(0) + ', ' +
      (x - sway) + ' ' + (len * 0.66).toFixed(0) + ', ' + (x + sway * 0.45).toFixed(0) + ' ' + len +
      '" stroke="' + fill + '" stroke-width="3" fill="none" opacity="0.85"/>';
    for (var i = 1; i < 7; i++) {
      var t = i / 7;
      var lx = x + Math.sin(t * 3.1) * sway * 0.8;
      var ly = t * len;
      g += '<ellipse cx="' + lx.toFixed(1) + '" cy="' + ly.toFixed(1) + '" rx="13" ry="7" fill="' +
        fill + '" opacity="0.9" transform="rotate(' + (t * 40 - 20).toFixed(1) + ' ' +
        lx.toFixed(1) + ' ' + ly.toFixed(1) + ')"/>';
    }
    return g;
  }

  if (key === 'dosel') {
    // La cámara mira hacia arriba: masa de copas arriba, lianas cayendo.
    out.push('<path d="M0 0 H1440 V' + (band === 'near' ? 300 : band === 'mid' ? 210 : 150) +
      ' C 1150 ' + (band === 'near' ? 250 : 170) + ', 980 ' + (band === 'near' ? 360 : 250) +
      ', 720 ' + (band === 'near' ? 300 : 205) + ' C 470 ' + (band === 'near' ? 250 : 165) +
      ', 250 ' + (band === 'near' ? 355 : 245) + ', 0 ' + (band === 'near' ? 285 : 195) + ' Z" fill="' + fill + '"/>');
    var leaves = band === 'near' ? 9 : band === 'mid' ? 14 : 18;
    for (var i = 0; i < leaves; i++) {
      out.push(leaf(span(-40, 1480), span(60, 330), span(110, 250), span(0.5, 1.25), span(0.55, 1)));
    }
    var vines = band === 'far' ? 7 : 4;
    for (var v = 0; v < vines; v++) {
      out.push(vine(span(40, 1400), span(320, 760), span(-46, 46)));
    }
    if (band !== 'far') out.push(trunk(band === 'near' ? 1180 : 120, 96, band === 'near' ? -70 : 60, 330));
  } else if (key === 'medio') {
    // Altura del pecho: troncos verticales y hoja ancha a media sombra.
    if (band !== 'far') {
      out.push(trunk(band === 'near' ? -40 : 300, band === 'near' ? 130 : 78, band === 'near' ? 90 : -44, band === 'near' ? 420 : 300));
      out.push(trunk(band === 'near' ? 1290 : 980, band === 'near' ? 118 : 66, band === 'near' ? -80 : 52, 470));
    } else {
      for (var t2 = 0; t2 < 6; t2++) out.push(trunk(span(-30, 1420), span(28, 52), span(-30, 30), 0));
    }
    var mLeaves = band === 'near' ? 8 : band === 'mid' ? 15 : 20;
    for (var m = 0; m < mLeaves; m++) {
      out.push(leaf(span(-60, 1500), span(180, 880), span(-42, 42) + (rnd() > 0.5 ? 180 : 0), span(0.55, 1.35), span(0.6, 1)));
    }
  } else if (key === 'suelo') {
    // Suelo húmedo: helechos, matas bajas y raíces.
    out.push('<path d="M0 900 V' + (band === 'near' ? 560 : band === 'mid' ? 640 : 700) +
      ' C 300 ' + (band === 'near' ? 600 : 660) + ', 560 ' + (band === 'near' ? 520 : 620) +
      ', 860 ' + (band === 'near' ? 585 : 665) + ' C 1120 ' + (band === 'near' ? 640 : 700) +
      ', 1290 ' + (band === 'near' ? 545 : 630) + ', 1440 ' + (band === 'near' ? 600 : 670) +
      ' V900 Z" fill="' + fill + '"/>');
    var fronds = band === 'near' ? 7 : band === 'mid' ? 11 : 14;
    for (var f = 0; f < fronds; f++) {
      var fx = span(-60, 1480);
      out.push(frond(fx, span(600, 890), span(-58, -10) + (rnd() > 0.5 ? 0 : 200), span(0.5, 1.15), span(0.65, 1)));
    }
    for (var r = 0; r < (band === 'far' ? 10 : 5); r++) {
      var rx = span(0, 1440), ry = span(700, 880);
      out.push('<ellipse cx="' + rx.toFixed(0) + '" cy="' + ry.toFixed(0) + '" rx="' +
        span(38, 96).toFixed(0) + '" ry="' + span(12, 26).toFixed(0) + '" fill="' + fill + '" opacity="0.75"/>');
    }
  } else {
    // Jardín: la vegetación se abre y se ordena. Menos densidad, más aire.
    out.push('<path d="M0 900 V' + (band === 'near' ? 640 : band === 'mid' ? 700 : 745) +
      ' Q 720 ' + (band === 'near' ? 690 : 748) + ' 1440 ' + (band === 'near' ? 648 : 712) +
      ' V900 Z" fill="' + fill + '"/>');
    var bushes = band === 'near' ? 5 : band === 'mid' ? 8 : 11;
    for (var b = 0; b < bushes; b++) {
      var bx = span(-40, 1480), by = span(660, 830), br = span(52, 132);
      out.push('<path d="M' + (bx - br) + ' ' + by + ' Q ' + bx + ' ' + (by - br * 1.15) + ' ' +
        (bx + br) + ' ' + by + ' Z" fill="' + fill + '" opacity="' + span(0.7, 1).toFixed(2) + '"/>');
    }
    if (band !== 'near') {
      for (var s2 = 0; s2 < 5; s2++) {
        var sx = span(60, 1380);
        out.push('<path d="M' + sx + ' ' + span(690, 760).toFixed(0) + ' v-' + span(70, 150).toFixed(0) +
          '" stroke="' + fill + '" stroke-width="5" stroke-linecap="round" opacity="0.8"/>');
      }
    }
  }
%>
<svg class="scene-figure" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <%- out.join('') %>
</svg>
