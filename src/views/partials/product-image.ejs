<% if (typeof image_url !== 'undefined' && image_url) { %>
  <img src="<%= image_url %>" alt="<%= name %>" class="h-full w-full object-cover <%= typeof imgClass !== 'undefined' ? imgClass : '' %>" />
<% } else { %>
  <%- include('plant', {
    category: typeof category !== 'undefined' ? category : '',
    pid: typeof pid !== 'undefined' ? pid : 0,
    name: typeof name !== 'undefined' ? name : 'Planta'
  }) %>
<% } %>
