<%
  // Todo lo que sigue lo lee una máquina antes que una persona: el rastreador
  // que indexa, el revisor que aprueba la cuenta de anuncios y el sistema que
  // arma la tarjeta de vista previa cuando alguien comparte el enlace.
  var pageTitle = (typeof title !== 'undefined' && title) ? title + ' · Arbórea' : 'Arbórea — Plantas que encuentran su lugar';
  var pageDesc = (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : site.description;
  var pageImage = (typeof metaImage !== 'undefined' && metaImage) ? metaImage : site.url(site.ogImage);
  var pageType = (typeof metaType !== 'undefined' && metaType) ? metaType : 'website';
  var structured = (typeof jsonLd !== 'undefined' && jsonLd) ? jsonLd : [];
  var events = (typeof trackEvents !== 'undefined' && trackEvents) ? trackEvents : [];
%>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDesc %>" />
<link rel="canonical" href="<%= canonical %>" />
<%# El carrito, el checkout y la cuenta no son destinos de búsqueda ni de %>
<%# anuncio: indexarlos gasta rastreo y expone páginas vacías al revisor. %>
<meta name="robots" content="<%= noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large' %>" />
<meta name="theme-color" content="#0b120e" />

<%# Vista previa del enlace: es lo que se ve en el anuncio compartido, en %>
<%# WhatsApp y en la tarjeta que arma TikTok al revisar el dominio. %>
<meta property="og:type" content="<%= pageType %>" />
<meta property="og:site_name" content="<%= site.name %>" />
<meta property="og:locale" content="<%= site.locale %>" />
<meta property="og:title" content="<%= pageTitle %>" />
<meta property="og:description" content="<%= pageDesc %>" />
<meta property="og:url" content="<%= canonical %>" />
<meta property="og:image" content="<%= pageImage %>" />
<meta property="og:image:alt" content="<%= site.name %> — <%= site.tagline %>" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= pageTitle %>" />
<meta name="twitter:description" content="<%= pageDesc %>" />
<meta name="twitter:image" content="<%= pageImage %>" />

<%# Verificación de propiedad del dominio. Google Search Console habilita %>
<%# Merchant Center; la de TikTok habilita el catálogo y los eventos web. %>
<% if (site.verification.google) { %><meta name="google-site-verification" content="<%= site.verification.google %>" /><% } %>
<% if (site.verification.tiktok) { %><meta name="tiktok-developers-site-verification" content="<%= site.verification.tiktok %>" /><% } %>

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%230b120e'/%3E%3Cpath fill='%23c8a86a' d='M12 4.4c-3.9 2.7-6 6-6 9.4C6 17.6 8.7 20.6 12 20.6s6-3 6-6.8c0-3.4-2.1-6.7-6-9.4zm0 3c2.3 1.9 3.6 4 3.6 5.9 0 2.4-1.6 4.3-3.6 4.3s-3.6-1.9-3.6-4.3c0-1.9 1.3-4 3.6-5.9z'/%3E%3C/svg%3E" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/output.css" />

<%# Datos estructurados. Es el único formato en que Google lee el precio y la %>
<%# disponibilidad de una ficha, y es lo que Merchant Center contrasta contra %>
<%# el feed: si no coinciden, el producto queda suspendido. %>
<% structured.forEach(function (node) { %>
<script type="application/ld+json" nonce="<%= nonce %>"><%- jsonForScript(node) %></script>
<% }) %>

<% if (site.needsConsent) { %>
<script type="application/json" id="measure-config" nonce="<%= nonce %>"><%- jsonForScript({
  ga4: site.analytics.ga4Id,
  ads: site.analytics.googleAdsId,
  adsPurchaseLabel: site.analytics.googleAdsPurchaseLabel,
  tiktok: site.analytics.tiktokPixelId,
  currency: site.currency
}) %></script>
<% if (events.length) { %>
<script type="application/json" id="measure-events" nonce="<%= nonce %>"><%- jsonForScript(events) %></script>
<% } %>
<script src="/js/measure.js" defer></script>
<% } %>

<script src="/js/site.js" defer></script>
<script src="/js/scene.js" defer></script>
<script src="/js/approach.js" defer></script>
