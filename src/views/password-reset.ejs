<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Elegir contraseña nueva' }) %></head>
<body>
  <%- include('partials/header') %>

  <section class="mx-auto max-w-sm px-6 pb-24 pt-36 sm:px-10">
    <% if (expired) { %>
      <h1 class="font-display text-5xl leading-[1.05] text-ink">Este enlace ya no sirve</h1>
      <p class="mt-6 text-sm font-light leading-relaxed text-sand">
        Los enlaces de recuperación duran una hora y se gastan al usarlos. Si pediste varios,
        solo el último es válido.
      </p>
      <p class="mt-10 text-sm text-sandDim">
        <a href="/recuperar" class="text-gold hover:underline">Pedir uno nuevo</a>
      </p>
    <% } else { %>
      <h1 class="font-display text-5xl leading-[1.05] text-ink">Una contraseña nueva</h1>
      <p class="mt-6 text-sm font-light leading-relaxed text-sand">
        Al guardarla se cierran todas las sesiones abiertas con la anterior, aquí y en
        cualquier otro dispositivo.
      </p>

      <% if (error) { %>
        <p class="mt-8 border-l-2 border-danger pl-4 text-sm text-danger" role="alert"><%= error %></p>
      <% } %>

      <form method="POST" class="mt-12 space-y-8">
<%- include('./partials/csrf') %>
        <div>
          <label for="new_password" class="mb-2 block text-[10px] uppercase tracking-wander text-sandDim">Nueva contraseña</label>
          <input id="new_password" type="password" name="new_password" required minlength="10"
                 autocomplete="new-password" class="field" />
          <p class="mt-2 text-xs text-sandDim">Mínimo 10 caracteres. Una frase larga es más segura que un símbolo raro.</p>
        </div>
        <div>
          <label for="confirm_password" class="mb-2 block text-[10px] uppercase tracking-wander text-sandDim">Repítela</label>
          <input id="confirm_password" type="password" name="confirm_password" required minlength="10"
                 autocomplete="new-password" class="field" />
        </div>
        <button type="submit" class="action-solid !flex w-full">Guardar y entrar</button>
      </form>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
